# Scorch TCSS Theme - Dark Red Scheme
"""Red-themed dark UI using Textual CSS Variables (TCSS).

This theme provides a cohesive red/dark color scheme with proper contrast ratios.
All colors are defined as variables for easy theming and consistency.
"""

// SCORCH THEME VARIABLES

/* Primary Colors - Red Theme */
$primary = #f87171;          /* Main red accent (high visibility) */
$secondary = #a78bfa;        /* Purple-blue for secondary elements */
$error = #ef4444;            /* Error/red state color */

/* Background Colors - Dark Mode */
$background = #0d0d0d;       /* Main app background (near black) */
$surface = #1a1a1a;          /* Content surface/background */
$panel-surface = #262626;    /* Panel/side panel background */

/* Text Colors - High Contrast */
$text = #f3f4f6;             /* Primary text (off-white) */
$secondary-text = #9ca3af;   /* Secondary/muted text */
$error-text = $error;        /* Error state text */

/* Border Colors - Consistent with theme */
$border = $primary;          /* Main border color (red) */
$border-focused = #f85050;   /* Focused/bordered element accent */

/* Button Colors - Interactive States */
$button-hover = $secondary;  /* Hover state for buttons */
$button-active = $primary;   /* Active/pressed button state */

// COMPONENT STYLES

/* Header Component */
#app-header {
    height: 2;
    border-bottom: thick solid $border;
    
    & > Header {
        font-size: 16px;
        text-color: $text;
        
        #title-text {
            color: $primary;
            font-weight: bold;
        }
    }
}

// Footer Component
#app-footer {
    height: 2;
    border-top: thick solid $border;
    padding: 0.5;
    
    & > Static#footer-content {
        font-size: small;
        text-color: $secondary-text;
    }
}

// Main Container
#main-container {
    width: 100%;
    height: calc(100% - 4); /* Subtract header and footer */
    
    &.small-terminal {
        display: none;
    }
}

/* Button Styling */
Button {
    padding: 0.5;
    margin-right: 0.25;
    background: $surface;
    border-color: $border;
    
    &:hover {
        background: $button-hover;
    }
    
    &:selected {
        border-color: $border-focused;
        color: #ffffff;
    }
}

/* Input Fields */
Input, MultiLine {
    padding: 0.5;
    background: surface;
    border-color: $border;
    
    &::placeholder {
        color: $secondary-text;
        opacity: 0.7;
    }
    
    &:focus-within {
        border-color: $primary;
    }
}

/* Static Widgets */
Static {
    background: surface;
    padding: 1;
    
    & > * {\n            margin-bottom: 0;\n            \n            &:last-child {\n                margin-bottom: 0;\n            }\n        }\n}

// Bordered Panel with Title in Border
BorderedPanel {
    background: $background;\n        
    border-color: $border;
    
    #panel-title {\n        font-size: 18px;\n        color: $primary;\n        text-align: center;\n        margin-bottom: 0.5;\n        
        &.dimmed {\n            opacity: 0.7;\n        }\n    }
    
    #panel-content {\n        padding: 1;\n        scrollable: true;\n    }\n}

// Progress Panel (Left Sidebar)\n#progress-panel {\n    width: 30%;\n    min-width: 250px;\n    max-height: calc(100% - 6);\n    overflow-y: auto;\n    padding: 1;\n    background: panel-surface;\n    border-color: $border;\n}

// Gallery Panel (Right Sidebar)\n#gallery-container {\n    width: 64%;\n    min-width: 350px;\n    max-height: calc(100% - 6);\n    overflow-y: auto;\n    padding: 1;\n    background: panel-surface;\n    border-color: $border;\n}

// Terminal Preview Widget
TerminalPreviewWidget {\n    background: #0d0d0d;\n    border-color: $border;\n    \n    & > * {\n        margin-bottom: 0.25;\n        \n        &:last-child {\n            margin-bottom: 0;\n        }\n    }\n}

// Message Bubbles (Chat)\n.message-bubble {\n    padding: 1;\n    background: surface;\n    border-radius: 4px;\n    \n    &.user-message {\n        background: $secondary;
            color: #ffffff;\n            margin-left: auto;\n            text-align: right;\n        }\n        \n    &.assistant-message {\n        margin-right: auto;\n    }\n}

// Streaming Indicator\n#streaming-indicator {\n    font-size: small;\n    color: $error;\n    margin-left: 0.5;\n    animation: pulse 1s infinite;\n}\n\n@keyframes pulse {\n    0%, 100% { opacity: 0.6; }\n    50% { opacity: 1; }\n}

// Small Terminal Warning\n#terminal-too-small {\n    width: 100%;\n    height: 100%;\n    text-align: center;\n    margin: auto;\n    font-size: 14px;\n    \n    & > Label {\n        color: $error;\n    }\n}

// Small Terminal Message\n#small-terminal-message {\n    font-size: 14px;\n    \n    & > Label {\n        color: $error;\n        text-align: center;\n        margin-top: 2;\n    }\n}
